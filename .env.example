# Solana Wallet Distributor Configuration
# Copy this file to .env and fill in your values

# Required: Your payer wallet private key (base58 encoded)
PAYER_PRIVATE=your-base58-private-key-here

# Network Configuration
# Options: mainnet-beta, testnet, devnet
# Default: testnet
# Note: Pump.fun trading ONLY works on mainnet-beta
SOLANA_NETWORK=testnet

# Optional: Custom RPC endpoint for mainnet
# Use a private RPC for better performance (Helius, QuickNode, etc.)
# MAINNET_RPC_URL=https://your-rpc-endpoint.com
